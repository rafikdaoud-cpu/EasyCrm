<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="status_nouveau" model="easycrm.status">
            <field name="name">New</field><field name="code">nouveau</field>
            <field name="sequence">1</field><field name="color">0</field>
            <field name="builtin" eval="True"/><field name="in_queue" eval="True"/>
        </record>
        <record id="status_interesse" model="easycrm.status">
            <field name="name">Interested / customer</field><field name="code">interesse</field>
            <field name="sequence">2</field><field name="color">10</field>
            <field name="builtin" eval="True"/><field name="is_client" eval="True"/>
        </record>
        <record id="status_injoignable" model="easycrm.status">
            <field name="name">Unreachable</field><field name="code">injoignable</field>
            <field name="sequence">3</field><field name="color">3</field>
            <field name="builtin" eval="True"/><field name="in_queue" eval="True"/>
            <field name="retry_hours">3</field>
        </record>
        <record id="status_rappel" model="easycrm.status">
            <field name="name">To call back</field><field name="code">rappel</field>
            <field name="sequence">4</field><field name="color">4</field>
            <field name="builtin" eval="True"/><field name="in_queue" eval="True"/>
            <field name="is_callback" eval="True"/>
        </record>
        <record id="status_pas_interesse" model="easycrm.status">
            <field name="name">Not interested</field><field name="code">pas_interesse</field>
            <field name="sequence">5</field><field name="color">1</field>
            <field name="builtin" eval="True"/><field name="is_lost" eval="True"/>
        </record>
        <record id="status_non_eligible" model="easycrm.status">
            <field name="name">Not eligible</field><field name="code">non_eligible</field>
            <field name="sequence">6</field><field name="color">9</field>
            <field name="builtin" eval="True"/><field name="is_lost" eval="True"/>
        </record>
        <record id="status_faux_numero" model="easycrm.status">
            <field name="name">Wrong number</field><field name="code">faux_numero</field>
            <field name="sequence">7</field><field name="color">2</field>
            <field name="builtin" eval="True"/><field name="is_lost" eval="True"/>
        </record>
    </data>
</odoo>
