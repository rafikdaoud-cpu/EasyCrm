<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_call_wizard_form" model="ir.ui.view">
        <field name="name">easycrm.call.wizard.form</field>
        <field name="model">easycrm.call.wizard</field>
        <field name="arch" type="xml">
            <form string="Log the call">
                <field name="prospect_id" invisible="1"/>
                <field name="is_callback" invisible="1"/>
                <field name="require_note" invisible="1"/>
                <h2><field name="prospect_name" readonly="1"/></h2>
                <div class="mb-3"><field name="prospect_phone" widget="phone" readonly="1"/></div>
                <group>
                    <field name="status_id" widget="radio" options="{'no_create': True}"/>
                    <field name="callback_date" invisible="not is_callback" required="is_callback"/>
                    <field name="note" required="require_note" placeholder="Call note…"/>
                    <field name="duration"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
                <footer>
                    <button name="action_save_next" type="object" string="Save &amp; next"
                            class="btn-primary" data-hotkey="n"/>
                    <button name="action_save" type="object" string="Save" data-hotkey="s"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
