<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_wizard_form" model="ir.ui.view">
        <field name="name">easycrm.import.wizard.form</field>
        <field name="model">easycrm.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import prospects">
                <field name="state" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                    Recognized columns: <b>Full name</b> (or Last name + First name), <b>Phone</b>, Phone 2,
                    Email, Gender, Wilaya / Region, Category, Remark, as well as the labels of your custom
                    fields. Phone numbers are normalized according to the configured country.
                </div>
                <group invisible="state != 'draft'">
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="category_id" options="{'no_create': True}"/>
                    <field name="user_id" options="{'no_create': True}"/>
                    <field name="skip_duplicates"/>
                </group>
                <group invisible="state != 'done'">
                    <field name="result" nolabel="1" colspan="2" readonly="1"/>
                    <field name="batch" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_batch" type="object" string="View imported prospects"
                            class="btn-primary" invisible="state != 'done'"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_import_wizard" model="ir.actions.act_window">
        <field name="name">Import (Excel / CSV)</field>
        <field name="res_model">easycrm.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
