# ---------- WhatsApp Cloud API (Meta) ----------
# Jeton libre que tu inventes, à recopier dans la config du webhook Meta
WA_VERIFY_TOKEN=change-moi-jeton-long-et-aleatoire
# Meta for Developers > ton app > Paramètres > Général > Clé secrète
WA_APP_SECRET=
# Jeton permanent de l'utilisateur système (Business Manager)
WA_ACCESS_TOKEN=
WA_GRAPH_VERSION=v25.0
# ID du numéro WhatsApp (pour envoyer les réponses des commerciaux)
WA_PHONE_NUMBER_ID=1456024377585345

# ---------- Nextcloud (CsmCloud) ----------
NC_URL=https://cloud.csmtaksit.dz
# Login AD du compte de service (celui que tu tapes pour te connecter)
NC_LOGIN=whatsapp
# Identifiant interne Nextcloud : la fin de l'URL WebDAV (Fichiers > Paramètres > WebDAV)
NC_USER_ID=6CA18F00-0142-4BB8-A7F3-03556FEBB17C
# Paramètres > Sécurité > « Créer un nouveau mot de passe d'application »
NC_APP_PASSWORD=
# Dossier racine dans Nextcloud (un sous-dossier par numéro y sera créé)
NC_ROOT=WhatsApp

# ---------- CRM (callcrm) ----------
# Laisser vide pour désactiver le transfert vers le CRM
CRM_URL=https://cloud.csmtaksit.dz/index.php/apps/callcrm/api/wa
# Même valeur que : occ config:app:set callcrm wa_secret
CRM_SECRET=

# ---------- Photos -> PDF ----------
# 1 = chaque photo reçue est aussi convertie en PDF (Stirling-PDF, sinon conversion locale)
IMAGE_TO_PDF=1
# 1 = garder la photo d'origine à côté du PDF, 0 = ne garder que le PDF
KEEP_IMAGE=1
# Stirling-PDF (vide = conversion locale uniquement)
STIRLING_URL=http://erp.csmtaksit.dz:8080
# Compte AD si Stirling est protégé par Nginx + AD (sinon laisser vide)
STIRLING_USER=
STIRLING_PASSWORD=
# Clé API si la sécurité intégrée de Stirling est activée (sinon laisser vide)
STIRLING_API_KEY=
# maintainAspectRatio (A4, proportions gardées) | fillPage | fitDocumentToImage
STIRLING_FIT=maintainAspectRatio
# color | greyscale | blackwhite
STIRLING_COLOR=color

# ---------- Options ----------
# 1 = accusé de réception automatique (1 fois par jour et par client), 0 = désactivé
AUTO_REPLY=1
AUTO_REPLY_TEXT=Bonjour, nous avons bien reçu votre document. Merci, notre équipe le traite rapidement.
MAX_MEDIA_MB=100
TZ_NAME=Africa/Algiers
