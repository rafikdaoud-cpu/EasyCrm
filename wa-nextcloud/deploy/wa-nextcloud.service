# /etc/systemd/system/wa-nextcloud.service
[Unit]
Description=WhatsApp -> Nextcloud webhook
After=network.target

[Service]
User=csmtak11
Group=csmtak11
WorkingDirectory=/home/csmtak11/wa-nextcloud
ExecStart=/home/csmtak11/wa-nextcloud/venv/bin/gunicorn -w 2 --threads 4 -b 127.0.0.1:8085 --access-logfile logs/access.log app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
